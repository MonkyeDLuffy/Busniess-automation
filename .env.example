# Copy to .env and fill in values.

# ── Server ──
PORT=5050

# Required — generates signed login cookies. Make it long & random.
AUTH_SECRET=

# ── Scraping performance ──
CONCURRENCY_LIMIT=5

# ── Google Sheets (optional) ──
# Either a path to the service-account JSON, or the full JSON as a single line.
GOOGLE_SERVICE_ACCOUNT_KEY=
SPREADSHEET_ID=
SHEET_TAB=Businesses

# ── NocoDB (primary destination for found businesses) ──
NOCODB_URL=https://app.nocodb.com
NOCODB_TOKEN=
NOCODB_BASE_ID=
NOCODB_TABLE_ID=
NOCODB_TABLE_NAME=Business-automation

# ── Resend email (optional) ──
RESEND_API_KEY=
RESEND_FROM=
UNSUBSCRIBE_URL=

# ── Email lookup fallback (optional) ──
HUNTER_API_KEY=
